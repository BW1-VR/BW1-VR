// The version resource of the mod itself, which ships as ddraw.dll.
//
// It is what tells this file apart from the other ddraw.dll files that can
// sit in a game folder: dxwrapper's stub, or a player's own DirectDraw fix.
// The installer reads ProductName here before it replaces a file.
#include <winver.h>
#include "../common/version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    BWVR_VERSION_MAJOR,BWVR_VERSION_MINOR,BWVR_VERSION_PATCH,0
 PRODUCTVERSION BWVR_VERSION_MAJOR,BWVR_VERSION_MINOR,BWVR_VERSION_PATCH,0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_DLL
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      BWVR_PUBLISHER
            VALUE "FileDescription",  BWVR_PRODUCT_NAME
            VALUE "FileVersion",      BWVR_VERSION_TEXT
            VALUE "InternalName",     "ddraw"
            VALUE "LegalCopyright",   BWVR_COPYRIGHT
            VALUE "OriginalFilename", "ddraw.dll"
            VALUE "ProductName",      BWVR_PRODUCT_NAME
            VALUE "ProductVersion",   BWVR_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
